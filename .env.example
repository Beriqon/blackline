NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only credential for the narrowly scoped booking/quote RPC. Never use NEXT_PUBLIC_.
BLACKLINE_BOOKING_TOKEN=GENERATE_A_RANDOM_SECRET_AND_REGISTER_ITS_SHA256_DIGEST
# Keep localhost/preview on test. Live also requires HTTPS and matching live keys.
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
